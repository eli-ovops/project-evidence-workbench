{
  "name": "project-evidence-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22.12.0"},
  "scripts": {
    "build": "tsc -p tsconfig.server.json && tsc --noEmit -p tsconfig.json && vite build",
    "start": "node build/server/main.js",
    "init": "node build/server/main.js --init",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run build && npm test"
  },
  "dependencies": {"react":"19.3.0", "react-dom":"19.3.0"},
  "devDependencies": {"vite":"8.3.4", "typescript":"5.7.3", "@types/node":"22.20.5", "@types/react":"19.2.2", "@types/react-dom":"19.2.2"}
}
